# Copy to .env and fill in. Never commit .env.
# All services have free tiers; no paid plan is needed.

# https://console.deepgram.com  (speech-to-text + text-to-speech)
DEEPGRAM_API_KEY=

# https://console.groq.com/keys  (LLM)
GROQ_API_KEY=

# OPTIONAL. https://app.tavily.com  (web-search enrichment of the product brief)
# Leave blank to disable; the bot works from your provided material alone.
TAVILY_API_KEY=

# OPTIONAL. Which Groq model runs the live call: gpt-oss (default) or qwen.
# See src/calle/llm_models.py and docs/evals/ for how they compare.
CALLE_LLM_MODEL=
